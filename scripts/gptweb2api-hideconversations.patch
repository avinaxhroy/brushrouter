diff --git a/internal/chatgpt/hide.go b/internal/chatgpt/hide.go
new file mode 100644
index 0000000..b2b2f65
--- /dev/null
+++ b/internal/chatgpt/hide.go
@@ -0,0 +1,64 @@
+package chatgpt
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"strings"
+	"time"
+)
+
+// hideFromHistory best-effort hides a throwaway conversation in the account
+// history. The Web UI's own delete sends PATCH /backend-api/conversation/{id}
+// with {"is_visible": false}; no sentinel or PoW is involved on that route.
+// Failure is silent: the image is already in hand, a leftover chat entry is
+// cosmetic. Opt out with GPTWEB_AUTO_HIDE_CONVERSATIONS=0.
+func (c *Client) hideFromHistory(ctx context.Context, conversationID string) {
+	if strings.EqualFold(strings.TrimSpace(os.Getenv("GPTWEB_AUTO_HIDE_CONVERSATIONS")), "0") ||
+		strings.EqualFold(strings.TrimSpace(os.Getenv("GPTWEB_AUTO_HIDE_CONVERSATIONS")), "false") {
+		return
+	}
+	conversationID = strings.TrimSpace(conversationID)
+	if conversationID == "" {
+		return
+	}
+	hideCtx, cancel := context.WithTimeout(ctx, 15*time.Second)
+	defer cancel()
+	token, cookie, accountID, err := c.session(hideCtx)
+	if err != nil || strings.TrimSpace(token) == "" {
+		return
+	}
+	endpoint := fmt.Sprintf("%s/backend-api/conversation/%s", c.baseURL, conversationID)
+	payload, err := json.Marshal(map[string]any{"is_visible": false})
+	if err != nil {
+		return
+	}
+	req, err := http.NewRequestWithContext(hideCtx, http.MethodPatch, endpoint, bytes.NewReader(payload))
+	if err != nil {
+		return
+	}
+	for k, v := range c.webHeaders(c.deviceID, newUUID()) {
+		req.Header.Set(k, v)
+	}
+	req.Header.Set("Authorization", "Bearer "+token)
+	if accountID != "" {
+		req.Header.Set("ChatGPT-Account-ID", accountID)
+	}
+	if cookie != "" {
+		req.Header.Set("Cookie", cookie)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode >= 300 {
+		fmt.Fprintf(os.Stderr, "gptweb: hide conversation %s rejected (status %d)\n", conversationID, resp.StatusCode)
+	}
+	_, _ = io.Copy(io.Discard, io.LimitReader(resp.Body, 1<<16))
+}
